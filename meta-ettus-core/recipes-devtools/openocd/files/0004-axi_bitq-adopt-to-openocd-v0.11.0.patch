From 75f315ec62505a9413990cb7e738f7fa36aee7c8 Mon Sep 17 00:00:00 2001
From: Joerg Hofrichter <joerg.hofrichter@ni.com>
Date: Wed, 16 Oct 2024 09:37:45 +0000
Subject: [PATCH] axi_bitq: adopt to openocd v0.11.0

Signed-off-by: Joerg Hofrichter <joerg.hofrichter@ni.com>

---
 src/jtag/drivers/axi_bitq.c | 13 ++++++++++---
 src/jtag/interfaces.c       |  6 ++++++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/src/jtag/drivers/axi_bitq.c b/src/jtag/drivers/axi_bitq.c
index c64ba3385..c632429eb 100644
--- a/src/jtag/drivers/axi_bitq.c
+++ b/src/jtag/drivers/axi_bitq.c
@@ -310,7 +310,9 @@ static int axi_bitq_execute_tms(struct jtag_command *cmd)
 	unsigned num_bits = cmd->cmd.tms->num_bits;
 	const uint8_t *bits = cmd->cmd.tms->bits;
 
-	DEBUG_JTAG_IO("TMS: %d bits", num_bits);
+#ifdef _DEBUG_JTAG_IO_
+	LOG_DEBUG("TMS: %d bits", num_bits);
+#endif
 
 	int tms = 0;
 	for (unsigned i = 0; i < num_bits; i++) {
@@ -663,15 +665,20 @@ static int axi_bitq_jtag_quit(void)
 
 static const char * const axi_bitq_transports[] = { "jtag", NULL };
 
-struct jtag_interface axi_bitq_interface = {
+static struct jtag_interface axi_bitq_interface = {
+	.execute_queue = axi_bitq_execute_queue,
+};
+
+struct adapter_driver axi_bitq_adapter_driver = {
 	.name = "axi_bitq",
 	.commands = axi_bitq_command_handlers,
 	.transports = axi_bitq_transports,
 
-	.execute_queue = axi_bitq_execute_queue,
 	.speed = axi_bitq_jtag_speed,
 	.khz = axi_bitq_adapter_khz,
 	.speed_div = axi_bitq_jtag_speed_div,
 	.init = axi_bitq_jtag_init,
 	.quit = axi_bitq_jtag_quit,
+
+        .jtag_ops = &axi_bitq_interface,
 };
diff --git a/src/jtag/interfaces.c b/src/jtag/interfaces.c
index 061a78f9c..94ae7403b 100644
--- a/src/jtag/interfaces.c
+++ b/src/jtag/interfaces.c
@@ -152,6 +152,9 @@ extern struct adapter_driver stlink_dap_adapter_driver;
 #if BUILD_RSHIM == 1
 extern struct adapter_driver rshim_dap_adapter_driver;
 #endif
+#if BUILD_AXIBITQ == 1
+extern struct adapter_driver axi_bitq_adapter_driver;
+#endif
 #endif /* standard drivers */
 
 /**
@@ -272,6 +275,9 @@ struct adapter_driver *adapter_drivers[] = {
 #if BUILD_RSHIM == 1
 		&rshim_dap_adapter_driver,
 #endif
+#if BUILD_AXIBITQ == 1
+                &axi_bitq_adapter_driver,
+#endif
 #endif /* standard drivers */
 		NULL,
 	};
