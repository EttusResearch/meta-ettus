From 325defda3eb3b16209d00b8915c77f7911b2a97e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=B6rg=20Hofrichter?= <joerg.hofrichter@emerson.com>
Date: Tue, 4 Nov 2025 09:21:43 +0100
Subject: [PATCH 4/4] mpm: adopt sys_utils.net to pyroute2 version 0.7.0

---
 mpm/python/usrp_mpm/sys_utils/net.py | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/mpm/python/usrp_mpm/sys_utils/net.py b/mpm/python/usrp_mpm/sys_utils/net.py
index 12f5453366..75a8111160 100644
--- a/mpm/python/usrp_mpm/sys_utils/net.py
+++ b/mpm/python/usrp_mpm/sys_utils/net.py
@@ -65,11 +65,21 @@ def get_iface_info(ifname):
 
     try:
         with IPRoute() as ipr:
-            links = ipr.link_lookup(ifname=ifname)
-            if len(links) == 0:
-                raise LookupError("No interfaces known with name `{}'!".format(ifname))
-            link_info = ipr.get_links(links)[0]
-            link_speed = get_link_speed(ifname)
+            if getattr(ipr, "filter_messages", None):
+                # Pyroute version >= 0.7.0
+                link_infos = ipr.filter_messages(
+                    lambda x: x.get_attr("IFLA_IFNAME") == ifname, ipr.link("dump")
+                )
+                if len(link_infos) == 0:
+                    raise LookupError("No interfaces known with name `{}'!".format(ifname))
+                link_info = link_infos[0]
+                link_speed = get_link_speed(ifname)
+            else:
+                links = ipr.link_lookup(ifname=ifname)
+                if len(links) == 0:
+                    raise LookupError("No interfaces known with name `{}'!".format(ifname))
+                link_info = ipr.get_links(links)[0]
+                link_speed = get_link_speed(ifname)
     except IndexError:
         raise LookupError("Could not get links for interface `{}'".format(ifname))
     mac_addr = link_info.get_attr("IFLA_ADDRESS")
-- 
