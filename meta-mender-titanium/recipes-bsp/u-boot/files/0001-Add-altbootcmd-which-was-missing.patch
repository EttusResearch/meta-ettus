From 69030ab584af6c4a2ab2e67a78fb71977bfcb20a Mon Sep 17 00:00:00 2001
From: Bjoern Bachmann <bjoern.bachmann@emerson.com>
Date: Thu, 9 Jul 2026 13:35:03 +0200
Subject: [PATCH 1/4] Add altbootcmd which was missing
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Adding Mender support

- CONFIG_ENV_REDUNDANT:
U-Boot uses this Kconfig symbol in env_internal.h to compile
in the redundant-env code. Without it, Mender's dual-copy
env won't work at runtime.
The #define CONFIG_SYS_REDUNDAND_ENVIRONMENT in ni-x410.h
only satisfies config_mender.h's C preprocessor check —
it does NOT enable the actual runtime behavior.

- CONFIG_ENV_OFFSET_REDUND=0x1000000:
Needed so U-Boot knows where to write the second env copy.
---
 configs/ni_x410_rev4_defconfig | 1 +
 configs/ni_x410_rev5_defconfig | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/configs/ni_x410_rev4_defconfig b/configs/ni_x410_rev4_defconfig
index ebb8ad8b833..c2c43707079 100644
--- a/configs/ni_x410_rev4_defconfig
+++ b/configs/ni_x410_rev4_defconfig
@@ -78,6 +78,7 @@ CONFIG_SPL_DM_SEQ_ALIAS=y
 # CONFIG_BLOCK_CACHE is not set
 CONFIG_BOOTCOUNT_LIMIT=y
 CONFIG_BOOTCOUNT_ENV=y
+CONFIG_BOOTCOUNT_ALTBOOTCMD="run mender_altbootcmd; run bootcmd"
 CONFIG_CLK_ZYNQMP=y
 CONFIG_DFU_RAM=y
 CONFIG_FPGA_XILINX=y
diff --git a/configs/ni_x410_rev5_defconfig b/configs/ni_x410_rev5_defconfig
index 0f3561704b0..609dbd18cb6 100644
--- a/configs/ni_x410_rev5_defconfig
+++ b/configs/ni_x410_rev5_defconfig
@@ -19,6 +19,7 @@ CONFIG_SYS_BOOTM_LEN=0x6400000
 CONFIG_SYS_LOAD_ADDR=0x8000000
 CONFIG_SPL_SIZE_LIMIT=0x2a000
 CONFIG_SPL=y
+CONFIG_ENV_OFFSET_REDUND=0x1000000
 CONFIG_BOOT_INIT_FILE="board/ni/zynqmp/x410_boot_init.txt"
 CONFIG_DEBUG_UART=y
 CONFIG_SYS_MEMTEST_START=0x00000000
@@ -71,11 +72,13 @@ CONFIG_CMD_EXT4_WRITE=y
 CONFIG_SPL_OF_CONTROL=y
 CONFIG_OF_BOARD=y
 CONFIG_ENV_IS_IN_MMC=y
+CONFIG_ENV_REDUNDANT=y
 CONFIG_NET_RANDOM_ETHADDR=y
 CONFIG_SPL_DM_SEQ_ALIAS=y
 CONFIG_SPL_BLOCK_CACHE=y
 CONFIG_BOOTCOUNT_LIMIT=y
 CONFIG_BOOTCOUNT_ENV=y
+CONFIG_BOOTCOUNT_ALTBOOTCMD="run mender_altbootcmd; run bootcmd"
 CONFIG_CLK_ZYNQMP=y
 CONFIG_DFU_RAM=y
 CONFIG_FPGA_XILINX=y
-- 
