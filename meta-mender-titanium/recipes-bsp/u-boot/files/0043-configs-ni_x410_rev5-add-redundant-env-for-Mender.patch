From 07a06dce1b58210eac8c3bea04adca11b1a541ed Mon Sep 17 00:00:00 2001
From: Bjoern Bachmann <bjoern.bachmann@emerson.com>
Date: Wed, 25 Mar 2026 16:31:25 +0100
Subject: [PATCH] Adding Mender support
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- CONFIG_ENV_REDUNDANT:
U-Boot uses this Kconfig symbol in env_internal.h to compile
in the redundant-env code. Without it, Mender's dual-copy
env won't work at runtime.
The #define CONFIG_SYS_REDUNDAND_ENVIRONMENT in ni-x410.h
only satisfies config_mender.h's C preprocessor check —
it does NOT enable the actual runtime behavior.

- CONFIG_ENV_OFFSET_REDUND=0x1000000:
Needed so U-Boot knows where to write the second env copy.
---
 configs/ni_x410_rev5_defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/configs/ni_x410_rev5_defconfig b/configs/ni_x410_rev5_defconfig
index 6eac60b7597..7f9910d2b44 100644
--- a/configs/ni_x410_rev5_defconfig
+++ b/configs/ni_x410_rev5_defconfig
@@ -19,6 +19,7 @@ CONFIG_SYS_BOOTM_LEN=0x6400000
 CONFIG_SYS_LOAD_ADDR=0x8000000
 CONFIG_SPL_SIZE_LIMIT=0x2a000
 CONFIG_SPL=y
+CONFIG_ENV_OFFSET_REDUND=0x1000000
 CONFIG_BOOT_INIT_FILE="board/ni/zynqmp/x410_boot_init.txt"
 CONFIG_PMUFW_INIT_FILE="board/ni/zynqmp/x410-rev5/pmu_fw.bin"
 CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_SRC_FILE="board/ni/zynqmp/x410-rev5/pm_cfg_obj.c"
@@ -74,6 +75,7 @@ CONFIG_CMD_EXT4_WRITE=y
 CONFIG_SPL_OF_CONTROL=y
 CONFIG_OF_BOARD=y
 CONFIG_ENV_IS_IN_MMC=y
+CONFIG_ENV_REDUNDANT=y
 CONFIG_NET_RANDOM_ETHADDR=y
 CONFIG_SPL_DM_SEQ_ALIAS=y
 # CONFIG_BLOCK_CACHE is not set
-- 
