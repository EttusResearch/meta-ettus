From 87b3debf55c43fc0a3c94114c7adbd2d0940c0e7 Mon Sep 17 00:00:00 2001
From: Bjoern Bachmann <bjoern.bachmann@emerson.com>
Date: Thu, 22 Jan 2026 14:02:20 +0100
Subject: [PATCH 32/37] Fix: Initial stack was in uninitialized DDR, causing
 crash before DDR initialization could complete.

---
 configs/ni_x410_rev4_defconfig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/configs/ni_x410_rev4_defconfig b/configs/ni_x410_rev4_defconfig
index 1d688d5add1..5204f5c1b46 100644
--- a/configs/ni_x410_rev4_defconfig
+++ b/configs/ni_x410_rev4_defconfig
@@ -12,7 +12,8 @@ CONFIG_ENV_OFFSET=0x800000
 CONFIG_SPL_STACK_R_ADDR=0x18000000
 CONFIG_SPL_STACK=0xfffffffc
 CONFIG_SPL_BSS_MAX_SIZE=0x80000
-CONFIG_SPL_STACK_R=y
+CONFIG_SPL_BSS_START_ADDR=0xfffe0000
+CONFIG_SYS_INIT_SP_BSS_OFFSET=0x10000
 CONFIG_SYS_BOOTM_LEN=0x6400000
 CONFIG_SYS_LOAD_ADDR=0x8000000
 CONFIG_SPL_SIZE_LIMIT=0x2a000
@@ -44,7 +45,6 @@ CONFIG_LOG_MAX_LEVEL=8
 CONFIG_LOG_DEFAULT_LEVEL=6
 # CONFIG_DISPLAY_CPUINFO is not set
 CONFIG_SPL_PAYLOAD="u-boot.bin"
-CONFIG_SPL_HAVE_INIT_STACK=y
 CONFIG_SPL_SYS_MALLOC=y
 CONFIG_SPL_HAS_CUSTOM_MALLOC_START=y
 CONFIG_SPL_CUSTOM_SYS_MALLOC_ADDR=0x20000000
-- 
2.43.0

