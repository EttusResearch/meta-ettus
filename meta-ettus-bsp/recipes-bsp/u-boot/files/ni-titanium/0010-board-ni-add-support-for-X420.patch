From 6292784709c4a77114ea4cefecd12f9be3ac5b62 Mon Sep 17 00:00:00 2001
From: Joerg Hofrichter <joerg.hofrichter@ni.com>
Date: Thu, 18 Apr 2024 13:43:17 +0200
Subject: [PATCH] board: ni: add support for X420

X420 uses the same dtb as the X410 but has a different mboard PID.

Signed-off-by: Joerg Hofrichter <joerg.hofrichter@ni.com>
---
 board/ni/zynqmp/board.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/board/ni/zynqmp/board.c b/board/ni/zynqmp/board.c
index 97d0f180f0..6755505d84 100644
--- a/board/ni/zynqmp/board.c
+++ b/board/ni/zynqmp/board.c
@@ -111,6 +111,7 @@ struct xboard_match {
 
 static const struct xboard_match mb_match[] = {
 	{ .pid = 0x0410, .name = "X410 (Titanium)", .dtb = "x410" },
+	{ .pid = 0x0420, .name = "X420 (Hafnium)",  .dtb = "x410" },
 	{ .pid = 0x0440, .name = "X440 (Ferratus)", .dtb = "x410" },
 	{},
 };
