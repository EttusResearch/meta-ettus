From bc759532119f69aa49a499d5b65b6294f5835b9d Mon Sep 17 00:00:00 2001
From: Bjoern Bachmann <bjoern.bachmann@emerson.com>
Date: Thu, 29 Jan 2026 11:14:01 +0100
Subject: [PATCH 2/7] fix SP address during SPL.

---
 configs/ni_x410_rev4_defconfig | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/configs/ni_x410_rev4_defconfig b/configs/ni_x410_rev4_defconfig
index fc022faf92b..95795ac9ef4 100644
--- a/configs/ni_x410_rev4_defconfig
+++ b/configs/ni_x410_rev4_defconfig
@@ -2,7 +2,7 @@ CONFIG_ARM=y
 CONFIG_SYS_VENDOR="ni"
 CONFIG_SYS_CONFIG_NAME="ni-x410-rev4"
 CONFIG_POSITION_INDEPENDENT=y
-CONFIG_SYS_INIT_SP_BSS_OFFSET=0x10000
+CONFIG_SYS_INIT_SP_BSS_OFFSET=0x180000
 CONFIG_ARCH_ZYNQMP=y
 CONFIG_TEXT_BASE=0x8000000
 CONFIG_SYS_MALLOC_LEN=0x4040000
@@ -12,8 +12,9 @@ CONFIG_ENV_OFFSET=0x800000
 CONFIG_DM_GPIO=y
 CONFIG_DEFAULT_DEVICE_TREE="zynqmp-ni-x410-rev4"
 CONFIG_OF_LIBFDT_OVERLAY=y
+CONFIG_SPL_STACK=0xfffffffc
 CONFIG_SPL_BSS_START_ADDR=0xfffe0000
-CONFIG_SPL_BSS_MAX_SIZE=0x80000
+CONFIG_SPL_BSS_MAX_SIZE=0x18000
 CONFIG_SYS_BOOTM_LEN=0x6400000
 CONFIG_SYS_LOAD_ADDR=0x8000000
 CONFIG_SPL_SIZE_LIMIT=0x2a000
@@ -43,6 +44,8 @@ CONFIG_LOG=y
 CONFIG_LOG_MAX_LEVEL=8
 CONFIG_LOG_DEFAULT_LEVEL=6
 # CONFIG_DISPLAY_CPUINFO is not set
+# CONFIG_SPL_SHARES_INIT_SP_ADDR is not set
+CONFIG_SPL_HAVE_INIT_STACK=y
 CONFIG_SPL_SYS_MALLOC=y
 CONFIG_SPL_HAS_CUSTOM_MALLOC_START=y
 CONFIG_SPL_CUSTOM_SYS_MALLOC_ADDR=0x20000000
-- 
2.43.0

