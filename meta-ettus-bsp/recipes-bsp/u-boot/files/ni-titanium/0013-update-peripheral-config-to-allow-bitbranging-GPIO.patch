index 788d85f9f97..20455a4ea55 100644
--- a/include/configs/ni-x410.h
+++ b/include/configs/ni-x410.h
@@ -16,11 +16,20 @@
         "ec_image=lib/firmware/ni/ec-titanium-rev2.RW.bin\0" \
         "expand_ec_image=setenv ec_image lib/firmware/ni/ec-titanium-rev${ec_compat}.RW.bin\0" \
         "load_addr=0x2000000\0" \
-        "fit_image=boot/fitImage\0" \
-        "uboot_root=mmc 0:2\0" \
