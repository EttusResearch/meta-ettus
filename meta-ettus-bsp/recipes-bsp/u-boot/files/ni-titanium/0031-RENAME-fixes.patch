From 3928c733748ed744fdf7cf86bae7c21cad64bdfa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=B6rg=20Hofrichter?= <joerg.hofrichter@emerson.com>
Date: Fri, 16 Jan 2026 16:41:45 +0100
Subject: [PATCH 31/37] RENAME: fixes

---
 board/ni/zynqmp/Makefile       |  4 ++-
 board/ni/zynqmp/board.c        | 64 ++++++++++++++++++++++++++--------
 configs/ni_x410_rev4_defconfig |  4 +--
 3 files changed, 54 insertions(+), 18 deletions(-)

diff --git a/board/ni/zynqmp/Makefile b/board/ni/zynqmp/Makefile
index eeb605be422..08d4f259a83 100644
--- a/board/ni/zynqmp/Makefile
+++ b/board/ni/zynqmp/Makefile
@@ -7,7 +7,7 @@ ZYNQMP_BASE := ../../xilinx/zynqmp
 obj-y += tlv_eeprom.o
 obj-y += board.o
 
-hw-platform-y := $(shell echo $(CONFIG_DEFAULT_DEVICE_TREE) | sed 's/^ni_//')
+hw-platform-y := $(shell echo $(CONFIG_DEFAULT_DEVICE_TREE) | sed 's/^zynqmp-ni-//')
 obj-$(CONFIG_XPL_BUILD) += $(hw-platform-y)/psu_init_gpl.o
 
 # to inlcude xil_io.h
@@ -34,3 +34,5 @@ else
 $(obj)/pm_cfg_obj.o: $(shell cd $(srctree); readlink -f $(CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_FILE)) FORCE
 endif
 endif
+
+obj-$(CONFIG_OF_BOARD) += $(ZYNQMP_BASE)/../common/board.o
diff --git a/board/ni/zynqmp/board.c b/board/ni/zynqmp/board.c
index 748b0a05738..651d0bdb46e 100644
--- a/board/ni/zynqmp/board.c
+++ b/board/ni/zynqmp/board.c
@@ -16,6 +16,7 @@
 #include <asm/io.h>
 #include <asm/system.h>
 #include <zynqmp_firmware.h>
+#include <linux/delay.h>
 
 #include "pm_cfg_obj.h"
 #include "log.h"
@@ -104,28 +105,61 @@ int zynq_board_read_rom_ethaddr(unsigned char *ethaddr)
 	return 0;
 }
 
-int board_early_init_f(void)
+
+int __maybe_unused psu_uboot_init(void)
 {
-	int ret = 0;
-#if !defined(CONFIG_SPL_BUILD) && defined(CONFIG_CLK_ZYNQMP)
-	u32 pm_api_version;
+	int ret;
 
-	pm_api_version = zynqmp_firmware_version();
-	printf("PMUFW:\tv%d.%d\n",
-	       pm_api_version >> ZYNQMP_PM_VERSION_MAJOR_SHIFT,
-	       pm_api_version & ZYNQMP_PM_VERSION_MINOR_MASK);
+	ret = psu_init();
+	if (ret)
+		return ret;
 
-	if (pm_api_version < ZYNQMP_PM_VERSION)
-		panic("PMUFW version error. Expected: v%d.%d\n",
-		      ZYNQMP_PM_VERSION_MAJOR, ZYNQMP_PM_VERSION_MINOR);
-#endif
+	/*
+	 * PS_SYSMON_ANALOG_BUS register determines mapping between SysMon
+	 * supply sense channel to SysMon supply registers inside the IP.
+	 * This register must be programmed to complete SysMon IP
+	 * configuration. The default register configuration after
+	 * power-up is incorrect. Hence, fix this by writing the
+	 * correct value - 0x3210.
+	 */
+	writel(ZYNQMP_PS_SYSMON_ANALOG_BUS_VAL,
+	       ZYNQMP_AMS_PS_SYSMON_ANALOG_BUS);
+
+	/* Disable secure access for boot devices */
+	writel(0x04920492, ZYNQMP_IOU_SECURE_SLCR);
+	writel(0x00920492, ZYNQMP_IOU_SECURE_SLCR + 4);
+
+	/* Enable CCI PMU events */
+	writel(ZYNQMP_CCI_REG_CCI_MISC_CTRL_NIDEN,
+	       ZYNQMP_CCI_REG_CCI_MISC_CTRL);
+
+	/* Delay is required for clocks to be propagated */
+	udelay(1000000);
+	
+	return 0;
+}
 
-#if defined(CONFIG_ZYNQMP_PSU_INIT_ENABLED)
-	ret = psu_init();
-#endif
+#if !defined(CONFIG_XPL_BUILD)
+# if defined(CONFIG_DEBUG_UART_BOARD_INIT)
+void board_debug_uart_init(void)
+{
+#  if defined(CONFIG_ZYNQMP_PSU_INIT_ENABLED)
+	psu_uboot_init();
+#  endif
+}
+# endif
 
+# if defined(CONFIG_BOARD_EARLY_INIT_F)
+int board_early_init_f(void)
+{
+	int ret = 0;
+#  if defined(CONFIG_ZYNQMP_PSU_INIT_ENABLED) && !defined(CONFIG_DEBUG_UART_BOARD_INIT)
+	ret = psu_uboot_init();
+#  endif
 	return ret;
 }
+# endif
+#endif
 
 int board_init(void)
 {
diff --git a/configs/ni_x410_rev4_defconfig b/configs/ni_x410_rev4_defconfig
index b1b2ed0b768..1d688d5add1 100644
--- a/configs/ni_x410_rev4_defconfig
+++ b/configs/ni_x410_rev4_defconfig
@@ -21,8 +21,8 @@ CONFIG_ENV_OFFSET_REDUND=0x1000000
 CONFIG_DEBUG_UART_BASE=0xff000000
 CONFIG_DEBUG_UART_CLOCK=100000000
 CONFIG_PMUFW_INIT_FILE=""
-CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_SRC_FILE="board/ni/zynqmp/x410-rev4/pm_cfg_obj.c"
-CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_FILE="board/ni/zynqmp/x410-rev4/pm_cfg_obj.o"
+# CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_SRC_FILE="board/ni/zynqmp/x410-rev4/pm_cfg_obj.c"
+# CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_FILE="board/ni/zynqmp/x410-rev4/pm_cfg_obj.o"
 CONFIG_BOOT_INIT_FILE="board/ni/zynqmp/x410_boot_init.txt"
 CONFIG_ZYNQMP_USB=y
 CONFIG_DEBUG_UART=y
-- 
2.43.0

