From ae0b14103a49b288babf8a4070f54d02e9001713 Mon Sep 17 00:00:00 2001
From: Bjoern Bachmann <bjoern.bachmann@emerson.com>
Date: Tue, 17 Mar 2026 09:47:18 +0100
Subject: [PATCH 7/7] Fix: Kernel 6.12 did NOT successfully load (hangs)
 without kernel command line param rootwait.

---
 include/configs/ni-x410.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/configs/ni-x410.h b/include/configs/ni-x410.h
index 8fc32381918..7e521521c5e 100644
--- a/include/configs/ni-x410.h
+++ b/include/configs/ni-x410.h
@@ -24,7 +24,7 @@
         "ec_disable_swsync=0\0" \
         "expand_ec_image=setenv ec_image lib/firmware/ni/ec-${ec_mboard}-rev${ec_compat}.RW.bin\0" \
         "load_addr=0x2000000\0" \
-        "bootargs=uio_pdrv_genirq.of_id=usrp-uio at24.io_limit=64\0" \
+        "bootargs=uio_pdrv_genirq.of_id=usrp-uio at24.io_limit=64  rootwait clk_ignore_unused\0" \
         "emmcboot=" \
           "setenv disk_name eMMC && " \
           "setenv uboot_root \"mmc 0:2\" && " \
-- 
