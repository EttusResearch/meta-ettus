From f48fd72af70c66b564bd2cb236c1278028a8167f Mon Sep 17 00:00:00 2001
From: Bjoern Bachmann <bjoern.bachmann@emerson.com>
Date: Fri, 6 Mar 2026 13:49:13 +0100
Subject: [PATCH 1/2] Fix: Set CONFIG_REMAKE_ELF to enable u-boot.elf build
 from the u-boot.bin including the dtb and no debug symbols.

---
 configs/ni_x410_rev4_defconfig | 1 +
 configs/ni_x410_rev5_defconfig | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/configs/ni_x410_rev4_defconfig b/configs/ni_x410_rev4_defconfig
index 24849c453f4..ebb8ad8b833 100644
--- a/configs/ni_x410_rev4_defconfig
+++ b/configs/ni_x410_rev4_defconfig
@@ -27,6 +27,7 @@ CONFIG_SYS_MEMTEST_START=0x00000000
 CONFIG_SYS_MEMTEST_END=0x00001000
 CONFIG_CC_OPTIMIZE_FOR_DEBUG=y
 CONFIG_SKIP_RELOCATE=y
+CONFIG_REMAKE_ELF=y
 CONFIG_EFI_LOADER_BOUNCE_BUFFER=y
 CONFIG_FIT=y
 CONFIG_FIT_VERBOSE=y
diff --git a/configs/ni_x410_rev5_defconfig b/configs/ni_x410_rev5_defconfig
index ae4a4f878fe..6eac60b7597 100644
--- a/configs/ni_x410_rev5_defconfig
+++ b/configs/ni_x410_rev5_defconfig
@@ -20,6 +20,7 @@ CONFIG_SYS_LOAD_ADDR=0x8000000
 CONFIG_SPL_SIZE_LIMIT=0x2a000
 CONFIG_SPL=y
 CONFIG_BOOT_INIT_FILE="board/ni/zynqmp/x410_boot_init.txt"
+CONFIG_PMUFW_INIT_FILE="board/ni/zynqmp/x410-rev5/pmu_fw.bin"
 CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_SRC_FILE="board/ni/zynqmp/x410-rev5/pm_cfg_obj.c"
 CONFIG_ZYNQMP_SPL_PM_CFG_OBJ_FILE="board/ni/zynqmp/x410-rev5/pm_cfg_obj.o"
 CONFIG_DEBUG_UART=y
@@ -27,6 +28,7 @@ CONFIG_SYS_MEMTEST_START=0x00000000
 CONFIG_SYS_MEMTEST_END=0x00001000
 CONFIG_CC_OPTIMIZE_FOR_DEBUG=y
 CONFIG_SKIP_RELOCATE=y
+CONFIG_REMAKE_ELF=y
 CONFIG_EFI_LOADER_BOUNCE_BUFFER=y
 CONFIG_FIT=y
 CONFIG_FIT_VERBOSE=y
@@ -141,4 +143,3 @@ CONFIG_WDT_CDNS=y
 # CONFIG_BINMAN_FDT is not set
 CONFIG_BINMAN_DTB="./arch/arm/dts/zynqmp-binman.dtb"
 CONFIG_TRACE=y
-CONFIG_PMUFW_INIT_FILE="board/ni/zynqmp/x410-rev5/pmu_fw.bin"
-- 
2.43.0

