+			if (ret) {
+				dev_err(&pdev->dev, "Ethernet Offload not Supported\n");
+				goto cleanup_clk;
+			}
+		}
 	} else {
 		struct xilinx_vdma_config cfg;
 		struct dma_chan *tx_chan;
