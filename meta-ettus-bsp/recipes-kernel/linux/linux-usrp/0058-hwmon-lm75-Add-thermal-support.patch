From 7534d5ed370c8c1bcca9a0ea13beecdcbbf93622 Mon Sep 17 00:00:00 2001
From: Moritz Fischer <moritz.fischer@ettus.com>
Date: Tue, 11 Jul 2017 10:16:08 -0700
Subject: [PATCH 058/110] hwmon: lm75: Add thermal support

Signed-off-by: Moritz Fischer <moritz.fischer@ettus.com>

Adopted to kernel 6.12

Signed-off-by: Bjoern Bachmann <bjoern.bachmann@emerson.com>
---
 drivers/hwmon/lm75.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/hwmon/lm75.c b/drivers/hwmon/lm75.c
index 2c2205aec7d40..cb6d18ba225be 100644
--- a/drivers/hwmon/lm75.c
+++ b/drivers/hwmon/lm75.c
@@ -17,6 +17,7 @@
 #include <linux/regmap.h>
 #include <linux/util_macros.h>
 #include <linux/regulator/consumer.h>
+#include <linux/thermal.h>
 #include "lm75.h"
 
 /*
@@ -568,6 +569,24 @@ static umode_t lm75_is_visible(const void *data, enum hwmon_sensor_types type,
 	return 0;
 }
 
+static int lm75_thermal_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct lm75_data *data = thermal_zone_device_priv(tz);
+	int err, regval;
+
+	err = regmap_read(data->regmap, LM75_REG_TEMP, &regval);
+	if (err < 0)
+		return err;
+
+	*temp = lm75_reg_to_mc(regval, data->resolution);
+
+	return 0;
+}
+
+const static struct thermal_zone_device_ops tzd_ops = {
+	.get_temp = lm75_thermal_get_temp,
+};
+
 static const struct hwmon_channel_info * const lm75_info[] = {
 	HWMON_CHANNEL_INFO(chip,
 			   HWMON_C_REGISTER_TZ | HWMON_C_UPDATE_INTERVAL),
@@ -610,6 +629,13 @@ static const struct regmap_config lm75_regmap_config = {
 	.use_single_write = true,
 };
 
+static int lm75_setup_thermal(struct device *dev, void *data)
+{
+	devm_thermal_of_zone_register(dev, 0, data, &tzd_ops);
+
+	return 0;
+}
+
 static void lm75_disable_regulator(void *data)
 {
 	struct lm75_data *lm75 = data;
@@ -715,6 +741,8 @@ static int lm75_probe(struct i2c_client *client)
 
 	dev_info(dev, "%s: sensor '%s'\n", dev_name(hwmon_dev), client->name);
 
+	lm75_setup_thermal(dev, data);
+	
 	return 0;
 }
 
