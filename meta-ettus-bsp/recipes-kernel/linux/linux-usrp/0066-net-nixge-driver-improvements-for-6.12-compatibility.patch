+static void nixge_ethtool_get_pauseparam(struct net_device *dev,
+		                        struct ethtool_pauseparam *pause)
+{
+	struct nixge_priv *priv = netdev_priv(dev);
+
+	pause->autoneg = AUTONEG_DISABLE;
+	pause->rx_pause = 0;
+	pause->tx_pause = priv->tx_pause_enable;
