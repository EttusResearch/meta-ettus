-			  MRMAC_GT_LANE_OFFSET * lp->gt_lane +
-			  MRMAC_GT_RATE_OFFSET));
-	else
-		iowrite32(MRMAC_GT_10G_MASK, (lp->gt_ctrl +
-			  MRMAC_GT_LANE_OFFSET * lp->gt_lane +
-			  MRMAC_GT_RATE_OFFSET));
+		/* Reset GT TX datapath */
+		val_gpio = MRMAC_GT_RST_TX_RX_MASK;
+		gpiod_set_array_value_cansleep(lp->gds_gt_tx_dpath->ndescs,
