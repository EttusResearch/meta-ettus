 	struct net_device *ndev;
@@ -628,6 +666,8 @@ struct axienet_local {
 	int rx_ring_tail;
 	bool eth_hasnobuf;
 	const struct axienet_config *axienet_config;
+	u64 ptp_os_cf;		/* CF TS of PTP PDelay req for one step usage */
+	u32 xxv_ip_version;
