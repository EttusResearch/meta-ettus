 .../zynq-ni-sulfur-rev3-eiscat-rev2.dts       | 31 +++++-----
 .../boot/dts/xilinx/zynq-ni-sulfur-rev3.dts   | 16 +++--
 drivers/hwmon/cros_ec_hwmon.c                 | 58 ++++++++++++++++++-
 7 files changed, 125 insertions(+), 68 deletions(-)

diff --git a/arch/arm/boot/dts/xilinx/ni-magnesium-db0.dtsi b/arch/arm/boot/dts/xilinx/ni-magnesium-db0.dtsi
index cec8bbf763aa..f2362ca60aa7 100644
--- a/arch/arm/boot/dts/xilinx/ni-magnesium-db0.dtsi
+++ b/arch/arm/boot/dts/xilinx/ni-magnesium-db0.dtsi
@@ -60,27 +60,32 @@ db0_crit: db0-crit {
 		};
 
 		cooling-maps {
+			/*
+			 * Preserve the original 6000/8000/12500/13500 RPM
+			 * thresholds as PWM states. This assumes 13500 RPM
+			 * corresponds to full PWM and a linear relationship.
+			 */
 			map0 {
 				trip = <&db0_alert0>;
-				cooling-device = <&fan1 THERMAL_NO_LIMIT 6000>;
+				cooling-device = <&fan1 0 113>; /* 0-6000 RPM equivalent */
 				contribution = <100>;
 			};
 
 			map1 {
 				trip = <&db0_alert1>;
-				cooling-device = <&fan1 6000 8000>;
+				cooling-device = <&fan1 113 151>; /* 6000-8000 RPM equivalent */
 				contribution = <100>;
 			};
 
 			map2 {
 				trip = <&db0_alert2>;
-				cooling-device = <&fan1 8000 12500>;
+				cooling-device = <&fan1 151 236>; /* 8000-12500 RPM equivalent */
 				contribution = <100>;
 			};
 
 			map3 {
 				trip = <&db0_crit>;
-				cooling-device = <&fan1 12500 13500>;
+				cooling-device = <&fan1 236 255>; /* 12500-13500 RPM equivalent */
 				contribution = <100>;
 			};
 
