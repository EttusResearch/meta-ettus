From 86890b39e46ff85edcf07d34e71a808635a47892 Mon Sep 17 00:00:00 2001
From: Srinivas Neeli <srinivas.neeli@amd.com>
Date: Mon, 6 Jan 2025 22:44:53 -1200
Subject: [PATCH 087/110] net: axienet: added multichannel DMA support

Add mcdma and multiqueue AXI DMA support to axi ethernet.

Signed-off-by: Srinivas Neeli <srinivas.neeli@amd.com>
Acked-by: Harini Katakam <harini.katakam@amd.com>
Signed-off-by: Suraj Gupta <suraj.gupta2@amd.com>
Reviewed-by: Radhey Shyam Pandey <radhey.shyam.pandey@amd.com>
State: not-upstreamable
Message-ID: <20250107104507.359136-16-suraj.gupta2@amd.com>
---
 drivers/net/ethernet/xilinx/Kconfig           |    6 +
 drivers/net/ethernet/xilinx/Makefile          |    3 +-
 drivers/net/ethernet/xilinx/xilinx_axienet.h  |  495 +++--
 .../net/ethernet/xilinx/xilinx_axienet_dma.c  |  439 +++++
 .../net/ethernet/xilinx/xilinx_axienet_main.c | 1620 ++++++++++-------
 .../ethernet/xilinx/xilinx_axienet_mcdma.c    | 1080 +++++++++++
 6 files changed, 2838 insertions(+), 805 deletions(-)
 create mode 100644 drivers/net/ethernet/xilinx/xilinx_axienet_dma.c
 create mode 100644 drivers/net/ethernet/xilinx/xilinx_axienet_mcdma.c

diff --git a/drivers/net/ethernet/xilinx/Kconfig b/drivers/net/ethernet/xilinx/Kconfig
index 7f0394d776d93..df0f9b19785b4 100644
--- a/drivers/net/ethernet/xilinx/Kconfig
+++ b/drivers/net/ethernet/xilinx/Kconfig
@@ -38,6 +38,12 @@ config XILINX_AXI_EMAC_HWTSTAMP
 	help
 	  Generate hardware packet timestamps. This is to facilitate IEEE 1588.
 
+config  AXIENET_HAS_MCDMA
+	bool "AXI Ethernet is configured with MCDMA"
+	depends on XILINX_AXI_EMAC
+	help
+	  When hardware is generated with AXI Ethernet with MCDMA select this option.
+
 config XILINX_LL_TEMAC
 	tristate "Xilinx LL TEMAC (LocalLink Tri-mode Ethernet MAC) driver"
 	depends on HAS_IOMEM
diff --git a/drivers/net/ethernet/xilinx/Makefile b/drivers/net/ethernet/xilinx/Makefile
index 7d7dc1771423e..6eed81e784581 100644
--- a/drivers/net/ethernet/xilinx/Makefile
+++ b/drivers/net/ethernet/xilinx/Makefile
@@ -6,5 +6,6 @@
 ll_temac-objs := ll_temac_main.o ll_temac_mdio.o
 obj-$(CONFIG_XILINX_LL_TEMAC) += ll_temac.o
 obj-$(CONFIG_XILINX_EMACLITE) += xilinx_emaclite.o
-xilinx_emac-objs := xilinx_axienet_main.o xilinx_axienet_mdio.o
+xilinx_emac-objs := xilinx_axienet_main.o xilinx_axienet_mdio.o xilinx_axienet_dma.o
 obj-$(CONFIG_XILINX_AXI_EMAC) += xilinx_emac.o
+obj-$(CONFIG_AXIENET_HAS_MCDMA) += xilinx_axienet_mcdma.o
