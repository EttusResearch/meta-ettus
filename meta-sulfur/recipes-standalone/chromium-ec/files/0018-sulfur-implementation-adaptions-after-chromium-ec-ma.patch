new file mode 100644
index 0000000000..90c5270fee
--- /dev/null
+++ b/board/sulfur/led.c
@@ -0,0 +1,28 @@
+#include "common.h"
+#include "gpio.h"
+#include "hooks.h"
+#include "chipset.h"
+
+/* POWER_LED is active-low: 0=ON, 1=OFF */
+
+static void led_shutdown(void)
+{
+    gpio_set_level(GPIO_POWER_LED, 1);  /* LED OFF */
+}
+DECLARE_HOOK(HOOK_CHIPSET_SHUTDOWN, led_shutdown, HOOK_PRIO_DEFAULT);
+
+static void led_resume(void)
+{
+    gpio_set_level(GPIO_POWER_LED, 0);  /* LED ON */
+}
+DECLARE_HOOK(HOOK_CHIPSET_RESUME, led_resume, HOOK_PRIO_DEFAULT);
+
+static void led_init(void)
+{
+    /* Set LED based on current chipset state */
+    if (chipset_in_state(CHIPSET_STATE_ON))
+        gpio_set_level(GPIO_POWER_LED, 0);  /* LED ON */
+    else
+        gpio_set_level(GPIO_POWER_LED, 1);  /* LED OFF */
+}
+DECLARE_HOOK(HOOK_INIT, led_init, HOOK_PRIO_DEFAULT);
