+static struct fan_speed_t fan_speed_state[FAN_CH_COUNT];
 
 int fan_percent_to_rpm(int fan, int pct)
 {
@@ -70,6 +131,9 @@ void fan_set_duty(int ch, int percent)
 {
 	const struct fan_t *fan = fans + ch;
 
