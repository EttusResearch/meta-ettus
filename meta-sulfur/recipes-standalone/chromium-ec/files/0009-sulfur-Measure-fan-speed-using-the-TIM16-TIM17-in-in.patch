+#define STM32_TIM_CCMR_IC1_PSC_1	(1 << 3)
+#define STM32_TIM_CCMR_IC1_PSC_0	(1 << 2)
+#define STM32_TIM_CCMR_CC1S_1		(1 << 1)
+#define STM32_TIM_CCMR_CC1S_0		(1 << 0)
+
+#define STM32_TIM_DIER_CC1IE		(1 << 1)
